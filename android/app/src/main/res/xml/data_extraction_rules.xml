<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup="false" already disables cloud backup and adb backup. These rules
  additionally exclude the app's data from Android 12+ device-to-device
  transfer. This is load-bearing, not hygiene: identity.enc, duress.enc, the
  unlock-guard state and tormsg.log all live in the files dir, and a duress- or
  removal-wiped device that could be restored from a transfer/backup containing
  the real account would defeat the entire local-security track.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
