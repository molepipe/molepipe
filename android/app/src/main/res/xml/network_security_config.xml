<?xml version="1.0" encoding="utf-8"?>
<!--
  The backend serves the UI over plain HTTP on loopback only (the same
  127.0.0.1:PORT the desktop build uses). Permit cleartext there and nowhere
  else; everything that leaves the device goes over Tor. If the WebView ever
  reports net::ERR_CLEARTEXT_NOT_PERMITTED, this file is why to look here first.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
