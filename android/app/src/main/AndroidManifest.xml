<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talk to the loopback backend and, later, to Tor. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scan a contact's account QR code in-app (WebView getUserMedia). Optional:
         the app works fully without a camera (paste the account instead). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Keep running so messages can arrive while the window is closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Query the active network so bindProcessToNetwork keeps Tor connected in Doze. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Show the persistent "running" notice on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep the CPU awake for Arti's onion-service maintenance while the screen
         is off (the FGS exempts network but not CPU suspension). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Let the user exempt the app from Doze so an aggressive OEM doesn't defer
         the always-on Tor node's network in deep idle. Requested, not forced. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Molepipe">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Molepipe"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Receive a photo from another app's share sheet. singleTop above is
              what makes this reuse the running instance — and the unlocked
              session behind its WebView — through onNewIntent, instead of
              stacking a second Activity with its own WebView.

              Single images only: without ACTION_SEND_MULTIPLE the share sheet
              does not offer us for a multi-select, which is honest about what
              the picker can then do with them.

              Not widened to application/octet-stream, which is how a file
              manager usually hands over a .cr2/.nef/.arw. Shared bytes cross
              the JS bridge as base64 and are held on both sides at once, so
              they are capped at 10 MB — and a camera RAW is 25-45 MB, which
              means that filter would put Molepipe in the share sheet for every
              untyped binary on the device in exchange for a path that then
              refuses the files it was added for. Picking a RAW with the photo
              button has no such cap: the WebView streams it off disk. A RAW
              the system DOES type as image/x-canon-cr2 and friends matches
              image/* above and shares fine if it is under the cap.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          The always-on backend. specialUse (not dataSync) because an always-on
          P2P Tor node has no time-capped equivalent among the standard FGS
          types, and dataSync is throttled on API 35+ — the OS would stop it,
          which is the exact failure the phone is meant to avoid.
        -->
        <service
            android:name=".BackendService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs an embedded Tor peer so the user can send and receive end-to-end encrypted messages while the app window is closed." />
        </service>

        <!--
          Serves the JPEG we transcode a picked HEIC/HEIF photo into (the WebView's
          Chromium can't decode HEIC), handing the WebView file input a readable
          content:// URI from our own cache. Not exported — same-app access only.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
